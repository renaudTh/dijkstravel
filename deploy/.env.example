# Copier en deploy/.env, puis remplir les secrets (openssl rand -hex 32).

# --- Disques -------------------------------------------------------------------------------------
# Graphes OSRM préparés (*.osrm*), lus seulement.
OSRM_DIR=/run/media/thomas/DATA/dijkstravel/data/osrm
# Cache de tuiles, polices et images : celui de la CLI, déjà rempli.
CACHE_DIR=/run/media/thomas/DATA/dijkstravel/data/cache
# Blocs de données de Garage (vidéos, couvertures, tournées).
GARAGE_DATA_DIR=/run/media/thomas/DATA/dijkstravel/studio/garage
# Laisser vides pour des volumes Docker nommés (recommandé : Postgres refuse NTFS).
# PG_DATA_DIR=
# GARAGE_META_DIR=
# SCRATCH_DIR=

# --- Import du dépôt au premier démarrage (runs déjà connus du studio non touchés) ----------------
IMPORT_RUNS_DIR=../runs
IMPORT_THEMES_DIR=../themes
IMPORT_OUT_DIR=/run/media/thomas/DATA/dijkstravel/data/out

# --- Accès ---------------------------------------------------------------------------------------
STUDIO_BIND=127.0.0.1
STUDIO_PORT=8080
# no tant que DATA n'est pas dans fstab : au boot, Docker créerait des dossiers vides sur /.
RESTART_POLICY=no

# --- Postgres ------------------------------------------------------------------------------------
POSTGRES_USER=dijkstravel
POSTGRES_DB=dijkstravel
POSTGRES_PASSWORD=

# --- Garage / S3 ---------------------------------------------------------------------------------
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
S3_BUCKET=dijkstravel
# Clé du studio, importée dans Garage : GK suivi de 24 caractères hexadécimaux, secret de 64.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Routage -------------------------------------------------------------------------------------
# Profils OSRM démarrés par ce compose : car, foot, train (15 Go de RAM : car seul par défaut).
COMPOSE_PROFILES=car
OSRM_CAR_GRAPH=france-routes
OSRM_FOOT_GRAPH=lyon-grenoble-foot
OSRM_TRAIN_GRAPH=france-rail
# Pour réutiliser les OSRM déjà lancés par le docker-compose.yml de la racine, vider
# COMPOSE_PROFILES et viser l'hôte :
# OSRM_URL=http://host.docker.internal:5000
# OSRM_TRAIN_URL=http://host.docker.internal:5002
# VROOM_URL=http://host.docker.internal:3000
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Worker --------------------------------------------------------------------------------------
WORKER_CONCURRENCY=1
# 0 : tous les cœurs alloués au conteneur.
RENDER_THREADS=0
WORKER_CPUS=5
WORKER_MEMORY=6g
